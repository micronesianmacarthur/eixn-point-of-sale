{
  "name": "eixn-pos-frontend",
  "version": "1.0.0",
  "description": "Front-end build for EIXN POS: Tailwind CSS plus vendored browser assets, so the till renders correctly with no network.",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "css": "tailwindcss -i frontend/app.css -o backend/static/css/app.css --minify",
    "css:watch": "tailwindcss -i frontend/app.css -o backend/static/css/app.css --watch",
    "vendor": "node scripts/vendor-static.mjs",
    "verify": "node scripts/verify-static.mjs",
    "build": "npm run vendor && npm run css && npm run verify"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/micronesianmacarthur/eixn-point-of-sale.git"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/micronesianmacarthur/eixn-point-of-sale/issues"
  },
  "homepage": "https://github.com/micronesianmacarthur/eixn-point-of-sale#readme",
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fortawesome/fontawesome-free": "^6.5.1",
    "@tailwindcss/cli": "^4.3.3",
    "alpinejs": "^3.14.8",
    "chart.js": "^2.8.0",
    "htmx.org": "^1.9.12",
    "tailwindcss": "^4.3.3"
  },
  "private": true
}
