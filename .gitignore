# Front-end build tooling (the built CSS and vendored assets under
# backend/static ARE committed, so a deployed till needs no node)
node_modules/

# Collected static files (whitenoise serves these in production)
backend/staticfiles/

# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Environment variables
.env

# SQLite (local fallback — not used in production)
db.sqlite3

# Uploaded media (logos, etc.)
backend/media/

# Database backups + status marker (runtime artifacts)
backend/backups/
backend/last_backup.txt
