# Django
SECRET_KEY=change-me-to-a-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
#   With Docker: uses port 5433 to avoid conflicting with a native PostgreSQL on 5432.
#   Production: docker-compose sets DATABASE_URL internally on port 5432.
#   Run scripts/setup-dev.sh to bootstrap.
DATABASE_URL=postgres://eixn:eixn@localhost:5433/eixn_pos

# S3 / Cloud Backup (optional)
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Thermal Printer (optional)
PRINTER_HOST=
PRINTER_PORT=9100
